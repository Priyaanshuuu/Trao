NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/interview-prep-kit
AUTH_INTERNAL_SECRET=replace-with-at-least-32-random-characters
